# ──────────────────────────────────────────────────────────────────────────────
# Lenny Growth Assistant — Environment Configuration
# Copy to .env and fill in values before running.
# All variables have safe defaults for local development.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Lenny Growth Assistant"
APP_VERSION="1.0.0"
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero-config):
DATABASE_URL=sqlite+aiosqlite:////app/data/lenny.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/lenny

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Primary provider: "ollama" | "anthropic" | "mock"
LLM_PROVIDER=ollama

# Fallback provider (used if primary fails): "mock" | "ollama" | "anthropic" | ""
LLM_FALLBACK_PROVIDER=mock

# Anthropic (optional — only needed if LLM_PROVIDER=anthropic or as fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama (local, mandatory for demo)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=120.0

# ── RAG / BM25 ────────────────────────────────────────────────────────────────
TRANSCRIPTS_DIR=/app/data/transcripts
BM25_INDEX_PATH=/app/data/bm25_index.pkl
RETRIEVAL_SCORE_THRESHOLD=15.5
RETRIEVAL_TOP_K=8
CHUNK_WORD_SIZE=200
CHUNK_OVERLAP=40

# ── Security / CORS ───────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use "*" for dev, specific origins for prod.
CORS_ORIGINS=["*"]

# ── Skills ────────────────────────────────────────────────────────────────────
SHIP30_MIN_WORDS=1100
SHIP30_MAX_WORDS=1400
SHIP30_MIN_HEADINGS=3
